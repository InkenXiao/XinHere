{
  "template_key": "oa_expense",
  "name": "费用报销",
  "version": 1,
  "scene": "oa",
  "related_system": "OA",
  "review_required": true,
  "period_rule": "none",
  "creator_roles": [],
  "title_rule": "{name}",
  "sub_rule": "提交后由审批人处理",
