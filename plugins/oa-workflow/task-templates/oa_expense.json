      { "k": "occur_date", "label": "费用发生日期", "type": "date", "required": false, "placeholder": "YYYY-MM-DD" },
      { "k": "detail", "label": "费用明细说明", "type": "textarea", "required": true, "placeholder": "列明费用构成，如交通/住宿/餐费" }
    ]
  },
  "lamp_mode": "none"
