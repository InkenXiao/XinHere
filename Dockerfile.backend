# XinHere 后端【运行时镜像】：只安装依赖，不 COPY 源码
# 源码/插件/契约由 docker-compose 卷挂载提供（保持 /app/apps/backend/app 目录深度，
# 不破坏 app/platform/plugins/loader.py 依 __file__ parents[5] 对 /app/plugins、
# /app/packages/contracts 的相对定位）。
# 发布约定：改代码/改环境变量 → 重启容器即生效（无需重建镜像）；
# 仅当 requirements.txt 变化时才需 docker compose build backend（重跑依赖层）。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/apps/backend

# 依赖层（requirements 变化时仅重跑这一层，代码变化不触发重建）
COPY apps/backend/requirements.txt /app/apps/backend/requirements.txt
RUN pip install -r /app/apps/backend/requirements.txt

# 健康检查用 curl（python:slim 不带）
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
