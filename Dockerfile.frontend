# XinHere 前端【运行时镜像】：纯 nginx，不含前端构建产物
# dist 由发布脚本在宿主构建后卷挂载到 /usr/share/nginx/html（改前端代码无需重建镜像）；
# 环境配置由 /docker-entrypoint.d/30-render-env.sh 渲染为 config.js（改 VITE_* 仅重启容器）。
FROM nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/config.js.template /etc/xinhere/config.js.template
COPY deploy/docker-entrypoint.d/30-render-env.sh /docker-entrypoint.d/30-render-env.sh

EXPOSE 80
